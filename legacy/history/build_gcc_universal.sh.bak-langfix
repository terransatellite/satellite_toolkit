#!/usr/bin/env bash
#
# build_gcc_universal.sh
#
# Build an optimised GCC from source on a fresh machine -- Debian/Ubuntu or
# RHEL/Fedora/Rocky/Alma.  Downloads the source itself, resolves the GMP/MPFR/
# MPC/ISL prerequisites itself, builds out-of-tree, and installs to a versioned
# prefix under $HOME.  Runnable from any directory; nothing depends on $PWD.
#
#   ./build_gcc_universal.sh
#
# Everything is overridable from the environment:
#
#   GCC_VERSION=16.2.0  PREFIX=$HOME/opt/gcc-mine  JOBS=8 \
#   MODE=plain  LANGUAGES=c,c++  INSTALL_DEPS=0  ./build_gcc_universal.sh
#
# WHICH GCC -- pick with TRACK:
#
#   ./build_gcc_universal.sh                    # newest RELEASE (the 16 series)
#   TRACK=snapshot ./build_gcc_universal.sh     # newest GCC 17 weekly snapshot
#   TRACK=snapshot SERIES=16 ./build_gcc_universal.sh
#   TRACK=git ./build_gcc_universal.sh          # trunk, right now, warts and all
#
# Root is used only to install distro packages.  The build itself is unprivileged
# and writes only under $SRC_ROOT and $PREFIX.  Never run this whole script with
# sudo: it would leave a root-owned tree in your home directory.
#
# Expect 2-5 hours and ~30 GB of disk in the default mode.
#
# Licence: public domain / CC0.  No warranty.

set -euo pipefail

# --- integrity self-check -------------------------------------------------
# This file must be pure ASCII.  Copying a script out of a web page or a chat
# window silently replaces ordinary spaces with U+00A0 (non-breaking space),
# which bash treats as part of a command name -- you get "command not found"
# on a line that looks perfectly correct.
#
# NOTE: the body below is deliberately NOT indented.  Leading whitespace is
# exactly what gets converted, so an indented error handler is unable to report
# the corruption it just detected -- it fails as "printf: command not found".
if LC_ALL=C tr -d '\11\12\40-\176' < "$0" | head -c 1 | LC_ALL=C grep -q .; then
printf 'ERROR: %s contains non-ASCII bytes.\n' "$0" >&2
printf 'It was almost certainly corrupted by copy-paste from a web page.\n' >&2
printf 'Repair it with:\n' >&2
printf "    sed -i 's/%s/ /g' %s\n" '\xc2\xa0' "$0" >&2
printf 'or, better, download the file directly instead of pasting it.\n' >&2
exit 1
fi
# --------------------------------------------------------------------------

# ---------------------------------------------------------------- configuration

# TRACK -- WHICH GCC gets built.  This is the choice to make deliberately.
#
#   release   (default)  Newest official release from ftp.gnu.org.  Today that
#             is the 16 series.  Tested, shipped, supported.  Use this one.
#
#   snapshot  Newest weekly source snapshot of $SERIES, default 17.  GCC 17 is
#             TRUNK -- it has not been released and is not finished.  Weekly
#             snapshots do get smoke-tested, so they are not chaos, but a
#             development compiler can and does miscompile valid code, and the
#             bug you hit may be three days old with no workaround written yet.
#             Excellent for trying new language features early.  A poor choice
#             for building anything you intend to run in anger.
#
#   git       Clone trunk and build $GIT_REF as it stands this minute.  Newer
#             than snapshot, correspondingly less baked, and a much larger
#             download.
#
# Nothing here stops you.  Just know which one you picked.
# HOST_CC / HOST_CXX -- the compiler that bootstraps GCC.
#
# GCC must be built by something that can build GCC, and in practice that means
# GCC.  Clang compiles GCC's own sources fine, but the in-tree GMP/MPFR/ISL
# prerequisites probe for working LTO and do it through the SYSTEM's
# LLVMgold.so.  If your clang is newer than that plugin, the probe fails with
#
#     bfd plugin: LLVM gold plugin has failed to create LTO module: Invalid record
#     configure: error: Link Time Optimisation is not supported
#
# and stage 1 dies before GCC itself is ever compiled.  An exported CC=clang in
# your shell is therefore silently fatal here, so this script does NOT inherit
# CC/CXX from the environment -- it picks a gcc and says which one.
# Override deliberately if you mean to:  HOST_CC=/path/to/gcc
HOST_CC="${HOST_CC:-}"
HOST_CXX="${HOST_CXX:-}"

TRACK="${TRACK:-release}"
SERIES="${SERIES:-17}"                        # snapshot series when TRACK=snapshot
GIT_REF="${GIT_REF:-master}"                  # branch/tag/sha when TRACK=git
GCC_GIT="${GCC_GIT:-https://gcc.gnu.org/git/gcc.git}"

# 'auto' means: newest release for TRACK=release, newest snapshot for
# TRACK=snapshot.  Pin it to skip discovery: 16.2.0, or 17-20260823.
GCC_VERSION="${GCC_VERSION:-auto}"
SRC_ROOT="${SRC_ROOT:-$HOME/src/gcc-build}"   # tarball + unpacked source live here
PREFIX="${PREFIX:-}"                          # default computed after version is known
JOBS="${JOBS:-$(nproc)}"
INSTALL_DEPS="${INSTALL_DEPS:-1}"             # 0 to skip the package step
LINK_CURRENT="${LINK_CURRENT:-1}"             # maintain $HOME/opt/gcc-current symlink
LANGUAGES="${LANGUAGES:-c,c++,lto}"           # add fortran,go,d,objc,ada as needed
MULTILIB="${MULTILIB:-0}"                     # 1 needs 32-bit headers installed

# MODE -- how hard to work for a faster compiler BINARY.
#
#   profiled-lto  (default) PGO + LTO bootstrap.  GCC is built, made to compile
#                 itself to collect a profile, then rebuilt using it, with LTO
#                 across the whole compiler.  This is the fastest gcc you can
#                 produce.  It is also the slowest to build and the most likely
#                 to hit a compiler-in-development bug.
#   lto           LTO bootstrap, no profiling.  Most of the win, much less time.
#   plain         Ordinary 3-stage bootstrap.  Always works.  Use this if a
#                 fancier mode fails, or if you just want a working gcc today.
#   quick         Stage-1 only, NO bootstrap.  Fast, but the resulting compiler
#                 was built by the host compiler and is not self-verified.
#                 Fine for a throwaway; do not ship from it.
MODE="${MODE:-profiled-lto}"

# --- Tuning.  Two DIFFERENT things get tuned, and conflating them is the usual
# --- mistake, so this script keeps them separate.
#
# 1. BOOT_ARCH -- flags used to compile the compiler ITSELF.  This binary is
#    going to sit in your home directory on this machine, so building it for
#    exactly this CPU is free real speed with no portability cost.  Default:
#    native.
BOOT_ARCH="${BOOT_ARCH:--march=native -mtune=native}"
#
# 2. WITH_ARCH / WITH_TUNE -- the DEFAULT -march/-mtune baked into the installed
#    compiler, i.e. what your programs get compiled for when you do not say.
#    WITH_ARCH is deliberately EMPTY.  Setting it to native means every binary
#    you subsequently build silently stops running on older machines, which is a
#    nasty surprise to inherit from a toolchain install.  WITH_TUNE is safe: it
#    schedules for this CPU but emits no instruction the baseline disallowed.
#
#    If this compiler only ever targets machines you control, prefer an ISA
#    LEVEL over a CPU name -- levels license exactly what a
#    __builtin_cpu_supports("x86-64-v3") check verifies, whereas -march=haswell
#    also licenses AES, RDRND, PCLMUL and INVPCID, and that gap is where a
#    SIGILL on somebody else's box lives:
#
#      WITH_ARCH=x86-64-v3 ./build_gcc_universal.sh
WITH_ARCH="${WITH_ARCH:-}"
WITH_TUNE="${WITH_TUNE:-native}"

say()  { printf '\n\033[1m==> %s\033[0m\n' "$*"; }
warn() { printf '\033[33mwarning:\033[0m %s\n' "$*" >&2; }
die()  { printf '\n\033[31mERROR:\033[0m %s\n' "$*" >&2; exit 1; }

[ "$(id -u)" -ne 0 ] || die "do not run this as root -- it installs into \$HOME.
       Run it as yourself; it will call sudo only for the package step."

# ------------------------------------------------------------------ dependencies

DNF_PKGS="gcc gcc-c++ make binutils bison flex texinfo gawk perl diffutils
          findutils patch tar xz bzip2 gzip wget curl file which
          zlib-devel glibc-devel"
APT_PKGS="build-essential bison flex texinfo gawk perl diffutils
          findutils patch tar xz-utils bzip2 gzip wget curl file
          zlib1g-dev libc6-dev"
# GMP/MPFR/MPC/ISL are deliberately NOT in these lists.  GCC ships
# contrib/download_prerequisites, which fetches the exact versions that release
# was tested against and builds them in-tree.  Distro versions are a common
# source of "works on my machine" bootstrap failures.

install_deps() {
    [ "$INSTALL_DEPS" = 1 ] || { warn "INSTALL_DEPS=0, skipping package install"; return 0; }
    local mgr=""
    command -v dnf     >/dev/null && mgr=dnf
    [ -z "$mgr" ] && command -v apt-get >/dev/null && mgr=apt
    [ -z "$mgr" ] && { warn "no dnf or apt-get -- install deps yourself, then re-run with INSTALL_DEPS=0"; return 0; }

    say "Installing dependencies with $mgr (sudo)"
    case "$mgr" in
      dnf) sudo dnf install -y $DNF_PKGS ;;
      apt) sudo apt-get update && sudo apt-get install -y $APT_PKGS ;;
    esac
    if [ "$MULTILIB" = 1 ]; then
        case "$mgr" in
          dnf) sudo dnf install -y glibc-devel.i686 libstdc++-devel.i686 || warn "32-bit headers unavailable; multilib may fail" ;;
          apt) sudo apt-get install -y gcc-multilib g++-multilib || warn "32-bit headers unavailable; multilib may fail" ;;
        esac
    fi
}

# -------------------------------------------------------------- version discovery

GNU_MIRRORS="https://ftp.gnu.org/gnu/gcc
             https://mirrors.kernel.org/gnu/gcc
             https://ftpmirror.gnu.org/gcc"

SNAP_MIRRORS="https://gcc.gnu.org/pub/gcc/snapshots
              https://mirrors.kernel.org/sourceware/gcc/snapshots"

# --compressed matters on every one of these listings: some mirrors serve them
# Content-Encoding: gzip, and a plain fetch hands back binary that quietly
# matches no pattern at all, which looks exactly like "no versions found".
latest_gcc_version() {
    local base html v
    for base in $GNU_MIRRORS; do
        html=$(curl -fsSL --compressed --max-time 30 "$base/" 2>/dev/null) || continue
        v=$(printf '%s\n' "$html" \
            | grep -oE 'gcc-[0-9]+\.[0-9]+\.[0-9]+/' \
            | sed -e 's|^gcc-||' -e 's|/$||' \
            | sort -V | tail -1)
        [ -n "$v" ] && { printf '%s' "$v"; return 0; }
    done
    return 1
}

latest_snapshot() {   # $1 = series -> prints e.g. 17-20260823
    local base html d
    for base in $SNAP_MIRRORS; do
        html=$(curl -fsSL --compressed --max-time 30 "$base/" 2>/dev/null) || continue
        d=$(printf '%s\n' "$html" | grep -oE "$1-[0-9]{8}/" | tr -d '/' | sort -V -u | tail -1)
        [ -n "$d" ] && { printf '%s' "$d"; return 0; }
    done
    return 1
}

fetch_from() {   # fetch_from <dest> <url>...
    local out="$1"; shift
    local url
    for url in "$@"; do
        say "Downloading $url"
        if curl -fL --retry 3 --retry-delay 5 -o "$out.part" "$url"; then
            mv "$out.part" "$out"; return 0
        fi
        rm -f "$out.part"
        warn "that mirror failed, trying the next one"
    done
    return 1
}

# ---------------------------------------------------------------------- preflight

install_deps

say "Preflight"
for t in curl tar xz make gcc g++ bison flex makeinfo; do
    command -v "$t" >/dev/null || die "missing: $t (install it, or drop INSTALL_DEPS=0)"
done
[ "$TRACK" = git ] && { command -v git >/dev/null || die "TRACK=git needs git installed"; }

# Prefer the distro gcc: it is the combination upstream actually tests against.
# A locally built trunk gcc can bootstrap a release, but when it does not, the
# failure looks like a GCC bug rather than a host-toolchain choice.
if [ -z "$HOST_CC" ]; then
    for _c in /usr/bin/gcc "$(command -v gcc 2>/dev/null || true)"; do
        [ -n "$_c" ] && [ -x "$_c" ] && { HOST_CC="$_c"; break; }
    done
fi
[ -n "$HOST_CC" ] && [ -x "$HOST_CC" ] || die "no gcc found to bootstrap with.
       Install one (dnf install gcc gcc-c++ / apt install build-essential),
       or set HOST_CC= and HOST_CXX= explicitly."
if [ -z "$HOST_CXX" ]; then
    HOST_CXX="${HOST_CC%gcc}g++"
    [ -x "$HOST_CXX" ] || HOST_CXX="$(command -v g++ 2>/dev/null || true)"
fi
[ -n "$HOST_CXX" ] && [ -x "$HOST_CXX" ] || die "found $HOST_CC but no matching g++"

if [ -n "${CC:-}" ] && [ "${CC:-}" != "$HOST_CC" ]; then
    warn "ignoring CC=$CC inherited from your environment.
       Bootstrapping with $HOST_CC instead -- see the HOST_CC note at the top of
       this script for why a clang CC breaks GCC's prerequisite builds.
       Set HOST_CC=$CC if you genuinely want that."
fi
export CC="$HOST_CC" CXX="$HOST_CXX"

# Resolve TRACK into: GCC_ID (names the prefix), SRC, and how to get the source.
URLS=(); TARBALL=""
case "$TRACK" in
  release)
    if [ "$GCC_VERSION" = auto ]; then
        say "Resolving the newest GCC release"
        GCC_VERSION=$(latest_gcc_version) \
            || die "could not reach a GNU mirror to discover the latest version.
       Pass one explicitly:  GCC_VERSION=16.2.0 $0"
    fi
    case "$GCC_VERSION" in
        [0-9]*.[0-9]*.[0-9]*) : ;;
        *) die "for TRACK=release, GCC_VERSION should look like 16.2.0, got '$GCC_VERSION'" ;;
    esac
    GCC_ID="$GCC_VERSION"
    SRC="$SRC_ROOT/gcc-$GCC_ID"
    TARBALL="$SRC_ROOT/gcc-$GCC_ID.tar.xz"
    for b in $GNU_MIRRORS; do URLS+=( "$b/gcc-$GCC_ID/gcc-$GCC_ID.tar.xz" ); done
    ;;
  snapshot)
    SNAP="$GCC_VERSION"
    if [ "$SNAP" = auto ]; then
        say "Resolving the newest GCC $SERIES snapshot"
        SNAP=$(latest_snapshot "$SERIES") \
            || die "could not list snapshots for series $SERIES.
       Pass one explicitly:  TRACK=snapshot GCC_VERSION=17-20260823 $0"
    fi
    case "$SNAP" in
        [0-9]*-[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]) : ;;
        *) die "for TRACK=snapshot, GCC_VERSION should look like 17-20260823, got '$SNAP'" ;;
    esac
    GCC_ID="$SNAP"
    SRC="$SRC_ROOT/gcc-$GCC_ID"
    TARBALL="$SRC_ROOT/gcc-$GCC_ID.tar.xz"
    for b in $SNAP_MIRRORS; do URLS+=( "$b/$GCC_ID/gcc-$GCC_ID.tar.xz" ); done
    ;;
  git)
    GCC_ID="git-$GIT_REF"          # refined to <BASE-VER>-git-<sha> after cloning
    SRC="$SRC_ROOT/gcc-git"
    ;;
  *) die "unknown TRACK='$TRACK' (release | snapshot | git)" ;;
esac

if [ "$TRACK" != release ]; then
    printf '\n\033[33m  ---------------------------------------------------------------\n'
    printf '   TRACK=%s: this is a DEVELOPMENT compiler, not a release.\n' "$TRACK"
    printf '   GCC %s has not shipped.  It can miscompile valid code.\n' "${SERIES:-trunk}"
    printf '   Install it alongside your working compiler, never over it.\n'
    printf '  ---------------------------------------------------------------\033[0m\n\n'
fi

mkdir -p "$SRC_ROOT"
avail=$(df -BG --output=avail "$SRC_ROOT" 2>/dev/null | tail -1 | tr -dc '0-9')
need=30; [ "$MODE" = plain ] && need=15; [ "$MODE" = quick ] && need=10
[ "$TRACK" = git ] && need=$((need + 5))
[ "${avail:-0}" -ge "$need" ] \
    || warn "only ${avail:-0}G free at $SRC_ROOT; MODE=$MODE typically needs ~${need}G"

ram=$(awk '/MemTotal/{printf "%d", $2/1048576}' /proc/meminfo 2>/dev/null || echo 0)
[ "${ram:-0}" -ge 4 ] || warn "only ${ram}G RAM; an LTO bootstrap links large objects and may OOM.
       Consider MODE=plain, or a smaller JOBS."

# ------------------------------------------------------------------------ source

if [ "$TRACK" = git ]; then
    if [ -d "$SRC/.git" ]; then
        say "Updating existing clone at $SRC"
        git -C "$SRC" fetch --depth 1 origin "$GIT_REF" \
            && git -C "$SRC" checkout -q FETCH_HEAD \
            || warn "fetch failed; building whatever is already checked out"
    else
        say "Cloning GCC trunk (shallow -- the full history is several GB)"
        git clone --depth 1 --branch "$GIT_REF" "$GCC_GIT" "$SRC" \
            || die "clone failed.  Try TRACK=snapshot, which is a plain tarball."
    fi
    # Now that the tree exists, name the prefix after what it actually IS.
    _bv=$(cat "$SRC/gcc/BASE-VER" 2>/dev/null || echo "$SERIES.0.0")
    _sha=$(git -C "$SRC" rev-parse --short HEAD 2>/dev/null || echo unknown)
    GCC_ID="$_bv-git-$_sha"
    printf '  trunk is %s at %s\n' "$_bv" "$_sha"
elif [ ! -d "$SRC" ]; then
    [ -f "$TARBALL" ] || fetch_from "$TARBALL" "${URLS[@]}" \
        || die "could not download gcc-$GCC_ID from any mirror"
    say "Verifying archive integrity"
    xz -t "$TARBALL" || { rm -f "$TARBALL"; die "tarball is corrupt; re-run to fetch it again"; }
    say "Unpacking"
    tar -C "$SRC_ROOT" -xf "$TARBALL"
    [ -d "$SRC" ] || die "unpacked tree is not at $SRC -- unexpected archive layout"
else
    say "Reusing existing source at $SRC"
fi

# The prefix is only knowable after a git checkout, so the collision check lives
# here rather than earlier.  For tarball tracks it is still before the build.
PREFIX="${PREFIX:-$HOME/opt/gcc-$GCC_ID}"
BUILD="$SRC_ROOT/build-gcc-$GCC_ID"       # MUST be outside $SRC; GCC requires it
[ -e "$PREFIX" ] && die "$PREFIX already exists.
       Never install over a prefix that something may be using.
       Remove it, or set PREFIX= to somewhere new."

printf '\n  track     : %s\n'   "$TRACK"
printf '  id        : %s\n'   "$GCC_ID"
printf '  mode      : %s\n'   "$MODE"
printf '  languages : %s\n'   "$LANGUAGES"
printf '  prefix    : %s\n'   "$PREFIX"
printf '  source    : %s\n'   "$SRC"
printf '  build     : %s\n'   "$BUILD"
printf '  jobs      : %s\n'   "$JOBS"
printf '  host cc   : %s\n'   "$HOST_CC"
printf '              %s\n'   "$("$HOST_CC" --version | head -1)"
printf '  boot flags: %s\n'   "$BOOT_ARCH"
printf '  default   : -march=%s -mtune=%s\n' "${WITH_ARCH:-<unset, portable>}" "$WITH_TUNE"
printf '  free disk : %sG\n  RAM       : %sG\n\n' "${avail:-?}" "${ram:-?}"

if [ ! -e "$SRC/gmp" ]; then
    say "Fetching in-tree prerequisites (GMP, MPFR, MPC, ISL)"
    # Run from inside the source tree: the script hardcodes relative paths.
    ( cd "$SRC" && ./contrib/download_prerequisites ) \
        || die "download_prerequisites failed -- check network, or install
       gmp-devel/mpfr-devel/libmpc-devel/isl-devel and re-run with
       CONFIGURE_EXTRA='--with-system-gmp' style flags."
else
    say "Prerequisites already present in the source tree"
fi

# --------------------------------------------------------------------- configure

say "Configuring (out of tree)"
rm -rf "$BUILD"; mkdir -p "$BUILD"; cd "$BUILD"

CONFIGURE_ARGS=(
    --prefix="$PREFIX"
    --enable-languages="$LANGUAGES"
    --enable-checking=release          # assertions off: a materially faster gcc
    --enable-threads=posix
    --enable-__cxa_atexit
    --enable-lto
    --enable-plugin
    --enable-default-pie
    --with-system-zlib
    --with-linker-hash-style=gnu
    --disable-werror                   # newer host compilers warn on older gcc source
    --with-tune="$WITH_TUNE"
)
# Passed as configure ARGUMENTS, not just env: these get recorded in
# config.status and inherited by every prerequisite sub-configure.
CONFIGURE_ARGS+=( CC="$HOST_CC" CXX="$HOST_CXX" )
[ -n "$WITH_ARCH" ] && CONFIGURE_ARGS+=( --with-arch="$WITH_ARCH" )
[ "$MULTILIB" = 1 ] || CONFIGURE_ARGS+=( --disable-multilib )
[ "$MODE" = quick ] && CONFIGURE_ARGS+=( --disable-bootstrap )
# shellcheck disable=SC2206
[ -n "${CONFIGURE_EXTRA:-}" ] && CONFIGURE_ARGS+=( ${CONFIGURE_EXTRA} )

"$SRC/configure" "${CONFIGURE_ARGS[@]}" 2>&1 | tee "$BUILD/configure.log"
[ -f "$BUILD/Makefile" ] || die "configure produced no Makefile -- see $BUILD/configure.log"

# ------------------------------------------------------------------------- build

case "$MODE" in
    profiled-lto) TARGET=profiledbootstrap; BCFG=bootstrap-lto ;;
    lto)          TARGET=bootstrap;         BCFG=bootstrap-lto ;;
    plain)        TARGET=bootstrap;         BCFG= ;;
    quick)        TARGET=;                  BCFG= ;;
    *) die "unknown MODE='$MODE' (profiled-lto | lto | plain | quick)" ;;
esac

say "Building: MODE=$MODE  target='${TARGET:-all}'  BUILD_CONFIG='${BCFG:-none}'"
printf '    This is the long part.  profiled-lto compiles GCC several times on\n'
printf '    purpose; that is what makes the final binary fast.\n'

MAKE_ARGS=( -j"$JOBS" )
[ -n "$BCFG" ]   && MAKE_ARGS+=( BUILD_CONFIG="$BCFG" )
[ -n "$BOOT_ARCH" ] && MAKE_ARGS+=( BOOT_CFLAGS="-O2 -g $BOOT_ARCH" BOOT_CXXFLAGS="-O2 -g $BOOT_ARCH" )
[ -n "$TARGET" ] && MAKE_ARGS+=( "$TARGET" )

if ! make "${MAKE_ARGS[@]}" 2>&1 | tee "$BUILD/build.log"; then
    printf '\n\033[31m--- errors found in the log ---\033[0m\n'
    grep -nE 'configure: error|error:|Error [0-9]+' "$BUILD/build.log" | tail -8 | sed 's/^/  /'
    # Stage 1 is byte-identical work in every MODE -- it is plain GCC compiled by
    # the host compiler.  Telling someone to change MODE after a stage-1 failure
    # sends them to rerun the exact same thing for another hour.
    if tail -300 "$BUILD/build.log" | grep -q 'stage1'; then
        die "the build failed during STAGE 1, with $HOST_CC as the host compiler.
       Stage 1 is the same work in every MODE, so changing MODE will NOT help.
       Stage-1 failures are nearly always the host toolchain, not GCC.
       Full log: $BUILD/build.log"
    fi
    die "the build failed in MODE=$MODE, after stage 1.
       A bootstrap that clears stage 1 and then fails is usually the mode itself:
           MODE=plain PREFIX=$PREFIX $0
       Full log: $BUILD/build.log"
fi

# ----------------------------------------------------------------------- install

say "Installing to $PREFIX"
make install-strip -j"$JOBS" || make install -j"$JOBS"

# ------------------------------------------------------------------------ verify
# A compiler that installs but cannot build and RUN a program is not installed.

say "Verifying the installed toolchain"
GXX="$PREFIX/bin/g++"; GCC="$PREFIX/bin/gcc"
[ -x "$GCC" ] || die "no gcc at $GCC"
[ -x "$GXX" ] || die "no g++ at $GXX"
printf '  %s\n' "$("$GCC" --version | head -1)"

tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
cat > "$tmp/t.cc" <<'EOF'
#include <string>
#include <vector>
#include <numeric>
#include <cstdio>
int main() {
    std::vector<int> v(10); std::iota(v.begin(), v.end(), 1);
    std::string s = "sum=" + std::to_string(std::accumulate(v.begin(), v.end(), 0));
    std::puts(s.c_str());
    return s == "sum=55" ? 0 : 1;
}
EOF
# The freshly built libstdc++ must be visible at run time, otherwise the test
# silently links against the system one and proves nothing about this install.
LIBDIRS="$PREFIX/lib64:$PREFIX/lib"
"$GXX" -std=c++20 -O2 "$tmp/t.cc" -o "$tmp/t" \
    -Wl,-rpath,"$PREFIX/lib64" -Wl,-rpath,"$PREFIX/lib" \
    || die "the installed g++ cannot compile a C++20 program"
out=$(LD_LIBRARY_PATH="$LIBDIRS${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" "$tmp/t") \
    || die "the test program compiled but did not run cleanly"
[ "$out" = "sum=55" ] || die "test program printed '$out', expected 'sum=55'"
printf '  c++20 compile + link + run : ok (%s)\n' "$out"

if [ -n "$WITH_ARCH" ]; then
    "$GCC" -Q --help=target 2>/dev/null | grep -q -- "-march=.*$WITH_ARCH" \
        && printf '  default -march              : %s\n' "$WITH_ARCH" \
        || warn "could not confirm the baked-in default -march"
fi

# ---------------------------------------------------------------------- activate

if [ "$LINK_CURRENT" = 1 ]; then
    mkdir -p "$HOME/opt"
    ln -sfn "$PREFIX" "$HOME/opt/gcc-current"
    printf '  gcc-current -> %s\n' "$(readlink -f "$HOME/opt/gcc-current")"
fi

say "Done"
cat <<EOF

  Installed: $PREFIX

  To use it, put it ahead of the system compiler:

      export PATH="$PREFIX/bin:\$PATH"
      export LD_LIBRARY_PATH="$PREFIX/lib64:$PREFIX/lib\${LD_LIBRARY_PATH:+:\$LD_LIBRARY_PATH}"

  That LD_LIBRARY_PATH matters.  Programs you build with this gcc link against
  its newer libstdc++, and at run time the dynamic loader must find it -- the
  system one is older and will refuse with a GLIBCXX_x.y.z version error.
  The alternative, if you would rather not set it globally, is to bake the path
  into each binary at link time:

      g++ -Wl,-rpath,$PREFIX/lib64 ...

EOF
